---
import mission from "../../../../content/missions/spirit.json";

// Spirit omits this optional setting; match the game's existing display default.
const sampleGoal = "sample_goal" in mission && typeof mission.sample_goal === "number"
  ? mission.sample_goal || 3
  : 3;
const missionJson = JSON.stringify(mission);
const heroPhoto = mission.gallery.find((item) => item.id === `${mission.id}-self`) || mission.gallery[1] || mission.gallery[0];
const heroPhotoSource = heroPhoto ? (mission.sources as Record<string, { label: string; url: string }>)[heroPhoto.source_id] : null;
const sourceById = (id: string) => (mission.sources as Record<string, { label: string; url: string }>)[id];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={`NASA: Lost Missions RPG mission about ${mission.rover_name} and abandoned NASA hardware.`} />
    <link rel="stylesheet" href="/site-theme.css" />
    <title>{mission.title} · {mission.subtitle}</title>
  </head>
  <body>
    <main id="wrap" tabindex="0" data-mission={missionJson}>
      <header id="hud" class="site-nav" aria-label="Primary navigation">
        <div class="brand-lockup"><a class="brand brand-home" href="/" aria-label="Return to NASA Lost Missions home"><span class="home-mark">⌂</span><span class="home-copy"><b>{mission.title}</b><small>ARCHIVE RETURN // HOME</small></span></a><small id="archiveLabel" class="archive-label">FIELD ARCHIVE / 2040</small></div>
        <div class="stats"><span>LV <b id="lv">1</b></span><span>XP <b id="xp">0</b></span><span>CLUES <b id="sm">0/{sampleGoal}</b></span></div>
        <div class="hud-actions nav-actions"><span class="unit-label">R.O.M. · SCN-01</span><button class="btn lang-btn" id="languageBtn" type="button">EN / ES</button><button class="btn audio-btn" id="musicBtn" type="button">♫ Music: ready</button><button class="btn" id="codexBtn" type="button">Open Codex</button></div>
      </header>

      <section id="game" aria-label="NASA Lost Missions RPG canvas">
        <div class="scene-label"><span id="fieldMapLabel">FIELD MAP</span><b>{mission.location.split(" · ")[0].toUpperCase()}</b><small id="solLabel">Sol 000 · Signal lost</small></div>
        <section id="playerCard" class="game-card player-card" aria-label="Player robot status">
          <div class="robot-portrait"><img src="/assets/rom/poses/analyzing.png" alt="R.O.M. analyzing field data" /></div>
          <div class="player-copy"><span class="card-kicker" id="fieldUnitLabel">FIELD UNIT · <b id="playerClass">SCN-01</b></span><h2 id="playerName">R.O.M.</h2><p id="playerRole">Field Research Robot</p><div class="unit-row"><span>LV <b id="lvPanel">1</b></span><span>XP <b id="xpPanel">0</b></span></div><div class="meter"><span id="energyLabel">ENERGY</span><i><b id="energyBar"></b></i><em id="energyText">100%</em></div><div class="meter data-meter-row" aria-hidden="true"><span id="dataLabel">DATA</span><i class="data-meter"><b id="dataBar"></b></i><em id="dataText">0 / 3</em></div></div>
        </section>
        <aside id="environmentCard" class="game-card environment-card" aria-label="Field status"><div class="card-kicker">FIELD STATUS</div><div class="env-main"><span class="env-icon">◉</span><div><small id="signalLabel">SIGNAL</small><strong id="envSignal">STABLE</strong></div><b id="envAtmosphere">CLEAR</b></div><p id="envNoticeText">Follow the beacon to Dr. Vega.</p><b id="envNoticeTitle" class="visually-hidden">MISSION ACTIVE</b></aside>
        <div id="storyNotice" class="story-notice" aria-live="polite"><span id="storyNoticeTag">NASA DATA</span><b id="storyNoticeTitle">MISSION ARCHIVE</b><p id="storyNoticeText"></p></div>
        <div class="map-frame"><canvas id="c" width="1440" height="900"></canvas></div>
        <div class="cinematic" id="cinematic" aria-live="polite">
          <div class="briefing-card"><div class="briefing-robot" aria-hidden="true"><i class="brief-antenna"></i><i class="brief-head"></i><i class="brief-eye left"></i><i class="brief-eye right"></i><i class="brief-body"></i><i class="brief-wheel left"></i><i class="brief-wheel right"></i></div><div class="briefing-copy"><span class="eyebrow">ASTRA-1 · MISSION BRIEFING</span><h2 id="briefingTitle">Welcome to Mars, explorer!</h2><p id="briefingText">{mission.rover_name} is waiting in {mission.location.split(" · ")[0]}. Move your robot, follow the glowing marker and investigate the objects you find.</p><div class="brief-steps"><span><b>1</b> <i id="stepMove">Move</i></span><span><b>2</b> <i id="stepFind">Find</i></span><span><b>3</b> <i id="stepDiscover">Discover</i></span></div><button class="btn cinematic-start" type="button">Start mission <span>→</span></button></div></div>
        </div>
        <div id="box" role="dialog" aria-live="polite"></div>
        <div id="stormGame" class="storm-game" role="dialog" aria-modal="true" aria-labelledby="stormTitle"><div class="storm-card storm-control-card"><div class="storm-kicker">ROBOT TOOL · POWER SURVIVAL</div><h2 id="stormTitle">PROTECT THE POWER</h2><p id="stormIntro"></p><div class="solar-readout"><span id="stormPowerLabel">POWER RESERVE</span><b id="stormEnergy">72%</b></div><div id="stormSystems" class="system-grid"></div><div class="energy-readout"><span id="stormSystemsLabel">SYSTEMS SAFE</span><b id="stormRound">0 / 3 OFF</b></div><p id="stormFeedback" class="storm-feedback">Turn off the systems that are not needed during the dust storm.</p><button id="stormAction" class="scan-action" type="button">ACTIVATE SAFE MODE</button></div></div>
        <div id="sampleGame" class="storm-game" role="dialog" aria-modal="true" aria-labelledby="sampleTitle"><div class="storm-card sample-card"><div class="storm-kicker">ROBOT TOOL · GEOLOGY SORTER</div><h2 id="sampleTitle">{mission.id === "opportunity" ? "SORT THE MARTIAN BLUEBERRIES" : "SORT THE ROCK SAMPLES"}</h2><p id="sampleIntro">{mission.id === "opportunity" ? "Select the dark, round hematite clues among the surface grains." : "Select the marked samples to catalogue the field."}</p><div id="sampleGrid" class="sample-grid"></div><div class="energy-readout"><span>{mission.id === "opportunity" ? "HEMATITE CLUES" : "FIELD SAMPLES"}</span><b id="sampleProgress">0 / {sampleGoal}</b></div><p id="sampleFeedback" class="storm-feedback">{mission.id === "opportunity" ? "Look for the round, dark-blue samples." : "Choose the samples highlighted by the scanner."}</p></div></div>
        <div id="scanGame" class="storm-game" role="dialog" aria-modal="true" aria-labelledby="scanTitle"><div class="storm-card scan-card"><div class="storm-kicker">ROBOT TOOL · SIGNAL SCANNER</div><h2 id="scanTitle">LOCK {mission.rover_name}'S SIGNAL</h2><p id="scanIntro">R.O.M. must align its scanner with the rover's weak transmission. Move the cursor into the cyan zone and press Enter or Space.</p><div class="scan-track"><i id="scanZone"></i><b id="scanCursor"></b></div><div class="energy-readout"><span id="scanQualityLabel">SCAN QUALITY</span><b id="scanQuality">0%</b></div><button id="scanAction" class="scan-action" type="button">LOCK SIGNAL</button><div id="scanFeedback" class="storm-feedback"></div></div></div>
        <div id="wireGame" class="storm-game" role="dialog" aria-modal="true" aria-labelledby="wireTitle"><div class="storm-card wire-card"><div class="storm-kicker">ROBOT TOOL · APXS MAINTENANCE</div><h2 id="wireTitle">CONNECT THE SENSOR WIRES</h2><p id="wireIntro">Match the colored terminals to bring the APXS online.</p><div id="wireBoard" class="wire-board"></div><div class="energy-readout"><span id="wireConnections">CONNECTIONS</span><b id="wireProgress">0 / 4</b></div><div id="wireFeedback" class="storm-feedback">Choose a colored terminal.</div></div></div>
        <div id="questionPopup" class="question-popup" role="dialog" aria-modal="true" aria-labelledby="questionTitle"><div class="question-card"><div id="questionKicker" class="storm-kicker">ASTRA-1 KNOWLEDGE CHECK</div><h2 id="questionTitle">Mission question</h2><p id="questionPrompt"></p><div id="questionOptions" class="question-options"></div><div id="questionFeedback" class="question-feedback"></div></div></div>
        <div id="photoPopup" class="photo-popup" role="dialog" aria-modal="true" aria-labelledby="photoTitle">
          <div class="photo-card"><div class="photo-kicker">NASA DATA · {mission.rover_name} / PANCAM</div><button class="photo-close" id="photoClose" type="button" aria-label="Close image">×</button><img id="photoImage" src={heroPhoto?.image_url} alt={heroPhoto?.title || `${mission.rover_name} on Mars`} /><div class="photo-caption"><h2 id="photoTitle">{heroPhoto?.title || `${mission.rover_name} on Mars`}</h2><p id="photoText">{heroPhoto?.kid_text || "A real image from NASA's archive. Study the rover before continuing your investigation."}</p><small id="photoCredit">{heroPhoto?.credit || "NASA"}</small><a id="photoSource" href={heroPhotoSource?.url || "#"} target="_blank" rel="noopener">VIEW NASA SOURCE ↗</a></div></div>
        </div>
        <div id="end">
          <div class="completion-card"><div class="completion-robot" aria-hidden="true"><i class="completion-antenna"></i><i class="completion-head"></i><i class="completion-eye left"></i><i class="completion-eye right"></i><i class="completion-body"></i><i class="completion-core"></i><i class="completion-wheel left"></i><i class="completion-wheel right"></i></div><div class="completion-copy"><span class="eyebrow">MISSION ARCHIVE UPDATED</span><h2>{mission.ending.title}</h2><p class="blue">{mission.ending.codex}</p><p class="orange">{mission.ending.tagline}</p><p class="historical-ending">{mission.story_arc.emotional_line}</p><div class="win-stats"><span><b id="winXp">+0</b><small>XP EARNED</small></span><span><b>6 / 6</b><small>STEPS SOLVED</small></span><span><b>NASA</b><small>DATA SAVED</small></span></div><div class="win-actions">{mission.id === "spirit" && <a class="btn win-next" href="/opportunity">Continue to Opportunity <span>→</span></a>}<a class="btn win-map" href="/missions">Return to mission map <span>→</span></a><button class="btn win-codex" id="winCodex" type="button">Open {mission.rover_name} Codex</button><button class="btn" id="restartBtn" type="button">Replay mission</button></div></div></div>
        </div>
        <div id="gameOver" class="game-over" role="dialog" aria-modal="true" aria-labelledby="gameOverTitle">
          <div class="game-over-card">
            <div class="game-over-icon">!</div>
            <span class="eyebrow">ASTRA-1 · POWER FAILURE</span>
            <h2 id="gameOverTitle">ENERGY DEPLETED</h2>
            <p>The robot used all its power before the evidence was secured.</p>
            <p class="game-over-tip">Restart the mission and try a different scan, sample or answer.</p>
            <button class="btn game-over-restart" id="gameOverRestart" type="button">Restart mission <span>↻</span></button>
          </div>
        </div>
      </section>

      <section id="cx" aria-label="Space Codex"><div class="codex-top"><b>SPACE CODEX · MARS · {mission.rover_name}</b><button class="btn" id="closeCodex" type="button">Close</button></div><p id="cxt">{mission.rover_name}: locked. Investigate the rover to unlock the mission file.</p><div id="gallery" class="gallery" aria-label="NASA image cards"></div><div class="hardware-codex"><h2 id="hardwareTitle">Hardware left behind</h2>{mission.hardware.map((item) => <article><h3>{item.name}</h3><p><b>What it was:</b> {item.what_it_was}</p><p><b>Why it was sent:</b> {item.why_sent}</p><p><b>Instrument:</b> {item.instrument}</p><p><b>Discovery:</b> {item.discovery}</p><p><b>Why it stayed:</b> {item.why_left}</p><p><b>What remains:</b> {item.what_remains}</p>{item.current_status && <><p><b>Current location:</b> {item.current_status.location}</p><p><b>Current status:</b> {item.current_status.status}</p><p><b>Last communication / event:</b> {item.current_status.last_event}</p><p><b>Still in use:</b> {item.current_status.still_in_use}</p>{sourceById(item.current_status.source_id) && <p><b>Status source:</b> <a href={sourceById(item.current_status.source_id).url} target="_blank" rel="noopener">{sourceById(item.current_status.source_id).label}</a></p>}</>}</article>)}</div><div class="source-grid">{Object.values(mission.sources).map((source) => <a href={source.url} target="_blank" rel="noopener">{source.label}</a>)}</div><p id="codexLegend"><b>NASA DATA</b> means sourced mission information. <b>ARCHIVE SIMULATION</b> means an interactive reconstruction. <b>GAME EVENT</b> means fictional framing.</p></section>

      <nav id="pad" aria-label="Mobile controls">
        <div class="move-pad">
          <span></span><button data-k="up" type="button">▲</button><span></span>
          <button data-k="left" type="button">◀</button><button data-k="down" type="button">▼</button><button data-k="right" type="button">▶</button>
        </div>
        <button class="a" data-k="act" type="button">A</button>
      </nav>

      <p id="tip">{mission.controls_tip}</p>
    </main>

    <script is:inline>
      document.querySelectorAll('#playerName, .briefing-copy .eyebrow, .game-over-card .eyebrow').forEach((node) => { node.textContent = node.textContent.replaceAll('ASTRA-1', 'R.O.M.'); });
    </script>
    <script>
      import { startSpiritRpg } from "../scripts/spiritRpg.js";
      startSpiritRpg(document.getElementById("wrap"));
    </script>
  </body>
</html>

<style>
  :root{box-sizing:border-box;color-scheme:dark;--space:#07080d;--panel:#111827;--blue:#58d9ff;--orange:#ff9a3c;--red:#e2573a;--muted:#8293aa}
  *{box-sizing:border-box}
  html,body{margin:0;width:100%;height:100%;min-width:320px;overflow:hidden;background:radial-gradient(circle at 50% 35%,#182033 0,#07080d 50%);color:#fff;font-family:"Courier New",monospace;user-select:none}
  #wrap{width:100%;height:100dvh;max-width:none;margin:0;padding:12px 18px;display:grid;grid-template-rows:42px minmax(0,1fr);gap:12px;outline:none}
  #hud{display:flex;align-items:center;justify-content:space-between;gap:18px;min-width:0;border-bottom:1px solid rgba(88,217,255,.26);padding:0 4px 10px;font-size:12px}
  #hud b{color:var(--orange)} .hud-actions{display:flex;align-items:center;gap:8px}.audio-btn{color:#b7c6d7;border-color:#4b6078}.brand-lockup{display:flex;align-items:center;gap:9px;white-space:nowrap}.brand-lockup small{color:var(--muted);font-size:9px}.brand{font-weight:900}.stats{display:flex;gap:18px;color:var(--muted)}.btn{border:1px solid var(--blue);border-radius:2px;background:#101827;color:#fff;padding:8px 12px;font:inherit;cursor:pointer}.btn:hover{background:#173047}
  #game{position:relative;min-height:0;overflow:hidden;border:1px solid rgba(255,154,60,.7);background:#000;box-shadow:0 18px 60px #0008}
  .map-frame{position:absolute;inset:0 310px 0 0;overflow:hidden;background:#8c3f27}.map-frame canvas{width:100%;height:100%;display:block;image-rendering:pixelated;background:#8c3f27}
  .game-card{position:absolute;z-index:3;border:1px solid rgba(88,217,255,.45);background:linear-gradient(135deg,rgba(7,16,29,.96),rgba(17,29,47,.93));box-shadow:0 10px 28px #0008;color:#fff}
  .player-card{top:16px;left:16px;width:292px;display:flex;gap:11px;padding:10px}.robot-portrait{position:relative;flex:0 0 64px;height:76px;background:linear-gradient(135deg,#14263a,#07111d);border:1px solid #38536b;overflow:hidden}.player-copy{min-width:0;flex:1}.card-kicker{color:var(--blue);font-size:9px;letter-spacing:.1em}.player-copy h2{margin:3px 0 1px;font:700 19px Arial,sans-serif;letter-spacing:.02em}.player-copy p{margin:0 0 5px;color:#9aabbd;font:10px Arial,sans-serif}.unit-row{display:flex;gap:13px;color:#8598ac;font-size:10px;margin-bottom:5px}.unit-row b{color:var(--orange)}.meter{display:grid;grid-template-columns:48px 1fr 29px;align-items:center;gap:5px;color:#8ea0b3;font-size:8px;margin-top:4px}.meter i{height:5px;background:#26394c;display:block}.meter i b{display:block;width:100%;height:100%;background:#66e6a5}.meter i.data-meter b{background:var(--blue);width:0}.meter em{font-style:normal;text-align:right;color:#d9e5f0;font-size:8px}
  .environment-card{top:16px;right:326px;width:235px;padding:11px 13px}.env-main{display:flex;align-items:center;gap:9px;margin:7px 0 9px}.env-icon{display:grid;place-items:center;width:25px;height:25px;border:1px solid #66e6a5;color:#66e6a5;border-radius:50%;font-size:12px}.env-main small{display:block;color:#8293aa;font-size:8px}.env-main strong{display:block;color:#66e6a5;font:700 13px Arial,sans-serif}.environment-card p{margin:8px 0 0;color:#d6e1eb;font:11px/1.25 Arial,sans-serif;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;min-height:27px}
  .story-notice{position:absolute;z-index:5;top:16px;left:calc((100% - 310px)/2);transform:translateX(-50%) translateY(-12px);width:min(560px,42%);padding:10px 16px;border:1px solid rgba(255,207,145,.72);border-left:4px solid var(--orange);background:rgba(7,16,29,.95);box-shadow:0 10px 30px #0009;opacity:0;visibility:hidden;pointer-events:none;transition:opacity .25s ease,transform .25s ease,visibility .25s ease}.story-notice.visible{opacity:1;visibility:visible;transform:translateX(-50%) translateY(0)}.story-notice span{display:block;color:var(--orange);font-size:9px;letter-spacing:.13em}.story-notice b{display:block;margin-top:3px;color:#fff;font:700 15px Arial,sans-serif}.story-notice p{margin:4px 0 0;color:#d8e4f0;font:12px/1.35 Arial,sans-serif}
  .scene-label{position:absolute;z-index:2;top:14px;left:16px;display:flex;flex-direction:column;gap:3px;text-shadow:0 2px 0 #000;pointer-events:none}.scene-label span{color:var(--orange);font-size:9px;letter-spacing:.16em}.scene-label b{font:700 16px Arial,sans-serif;letter-spacing:.04em}.scene-label small{color:#b5c0cf;font-size:10px}
  .eyebrow{color:var(--blue);font-size:10px;letter-spacing:.14em;font-weight:700}
  .cinematic{position:absolute;inset:0;z-index:6;display:flex;align-items:center;background:#07080d;transition:opacity .5s ease,visibility .5s ease}.cinematic.is-hidden{opacity:0;visibility:hidden;pointer-events:none}.cinematic-start{margin-top:14px;padding:11px 14px;border-color:var(--orange);background:var(--orange);color:#170f0a;font-weight:700}.cinematic-start span{margin-left:18px}
  .entity-label{position:absolute;z-index:3;display:none;pointer-events:none;transform:translate(-50%,-100%);padding:4px 7px;border:1px solid rgba(88,217,255,.65);background:#07101ddd;color:#fff;font:700 10px Arial,sans-serif;letter-spacing:.05em;white-space:nowrap}.entity-label.visible{display:block}.entity-label:after{content:"";position:absolute;left:50%;bottom:-6px;border:3px solid transparent;border-top-color:rgba(88,217,255,.65);transform:translateX(-50%)}
  .storm-game{position:absolute;z-index:13;inset:0;display:none;align-items:center;justify-content:center;background:#1a0d08cc;padding:18px}.storm-game.open{display:flex}.storm-card{width:min(590px,94%);border:2px solid var(--orange);background:#0b1422;padding:20px;box-shadow:0 18px 60px #000c}.storm-kicker{color:var(--orange);font-size:10px;letter-spacing:.12em}.storm-card h2{margin:7px 0 5px;font:700 28px Arial,sans-serif}.storm-card p{margin:0 0 15px;color:#b4c2d2;font:14px/1.4 Arial,sans-serif}.energy-readout{display:flex;justify-content:space-between;align-items:center;margin-bottom:10px;color:#91a0b5;font-size:10px}.energy-readout b{color:#77e6b0;font:700 17px Arial,sans-serif}.storm-feedback{margin-top:10px;color:#ffcf91;font:12px Arial,sans-serif}.interaction-hint{position:absolute;z-index:4;display:none;pointer-events:none;transform:translate(-50%,0);padding:3px 6px;background:var(--orange);color:#1b120c;font:700 9px Arial,sans-serif;letter-spacing:.05em}.interaction-hint.visible{display:block}
  #photoPopup{position:absolute;z-index:14;inset:0;display:none;align-items:center;justify-content:center;background:#04070dcc;padding:28px}#photoPopup.open{display:flex}.photo-card{position:relative;width:min(660px,94%);max-height:92%;overflow:auto;border:1px solid var(--blue);background:#0d1725;box-shadow:0 20px 80px #000d}.photo-card img{display:block;width:100%;max-height:47vh;object-fit:cover}.photo-kicker{position:absolute;z-index:2;top:12px;left:14px;color:#fff;background:#07101dcc;padding:5px 7px;font:10px "Courier New",monospace;letter-spacing:.1em}.photo-close{position:absolute;z-index:3;right:10px;top:8px;border:1px solid #fff8;background:#07101dcc;color:#fff;width:30px;height:30px;font-size:22px;cursor:pointer}.photo-caption{padding:16px 18px 18px}.photo-caption h2{margin:0 0 5px;font:700 26px Arial,sans-serif}.photo-caption p{margin:0 0 8px;color:#b4c2d2;font:14px/1.4 Arial,sans-serif}.photo-caption small{display:block;color:#ffcf91;margin-bottom:8px}.photo-caption a{color:var(--blue);font-size:11px}
  #box{position:absolute;z-index:8;left:18px;right:328px;bottom:18px;display:none;border:3px solid #303848;border-radius:3px;background:#f8f8f0;color:#202028;padding:11px 14px;font-size:clamp(12px,1.3vw,17px);line-height:1.4;cursor:pointer;box-shadow:0 8px 30px #0008}#box a{color:#0b6e8a;font-size:.8em}
  #end{position:absolute;z-index:15;inset:0;display:none;flex-direction:column;align-items:center;justify-content:center;gap:8px;background:linear-gradient(135deg,#071321f2,#1b0d0af2);padding:22px;text-align:center}
  .win-stats{display:flex;gap:24px;margin:12px 0 6px}.win-stats span{display:flex;flex-direction:column;gap:4px}.win-stats b{color:var(--orange);font:700 18px Arial,sans-serif}.win-stats small{color:#91a0b5;font-size:9px}.win-actions{display:flex;gap:8px;flex-wrap:wrap;justify-content:center}.win-codex{background:var(--orange);border-color:var(--orange);color:#1b120c;font-weight:700}.win-next{background:#66e6a5!important;border-color:#9ff7c8!important;color:#071b16!important;font-weight:700;text-decoration:none}.win-next span{margin-left:12px}
  #end h2{margin:0;color:var(--orange);font:700 clamp(20px,4vw,38px) Arial,sans-serif}#end p{margin:0}.blue{color:var(--blue)}.orange{color:var(--orange)}
  #cx{position:fixed;z-index:20;inset:7vh 7vw;display:none;overflow:auto;border:1px solid var(--blue);background:#0d1422;padding:20px;box-shadow:0 20px 70px #000c;font-size:12px;line-height:1.45}#cx.open{display:block}.codex-top{display:flex;justify-content:space-between;align-items:center;color:var(--blue)}#cx p{color:#dbe6f6}.gallery{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px;margin-top:14px}.edu-card{display:grid;grid-template-rows:145px auto;gap:9px;border:1px solid rgba(88,217,255,.35);background:#111a2b;padding:8px}.edu-card img{width:100%;height:100%;object-fit:cover}.edu-card p{margin:4px 0}.edu-card small{display:block;color:#ffcf91;margin-bottom:4px}.source-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:5px 12px;margin-top:12px}.source-grid a{color:var(--blue)}
  #pad{display:none}#tip{display:none}
